# ============================================================
#  .env — Variabili d'ambiente per l'intero stack
#  COPIA questo file in .env e compila i valori
#  NON committare .env su git!
# ============================================================

# ── Grafana ─────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=changeme

# ── n8n ─────────────────────────────────────────────────────
N8N_BASIC_AUTH_PASSWORD=changeme

# ── Semaphore ────────────────────────────────────────────────
SEMAPHORE_DB_PASS=semaphore_pass
SEMAPHORE_ADMIN_PASSWORD=changeme
SEMAPHORE_ACCESS_KEY_ENCRYPTION=   # openssl rand -base64 32

# ── NetBox ───────────────────────────────────────────────────
NETBOX_DB_PASSWORD=netbox_pass
NETBOX_SUPERUSER_PASSWORD=changeme
NETBOX_SECRET_KEY=                 # openssl rand -base64 64

# ── Authelia ─────────────────────────────────────────────────
AUTHELIA_SESSION_SECRET=           # openssl rand -base64 32
AUTHELIA_JWT_SECRET=               # openssl rand -base64 32

# ── Twingate ─────────────────────────────────────────────────
TWINGATE_NETWORK=yournetwork.twingate.com
TWINGATE_ACCESS_TOKEN=
TWINGATE_REFRESH_TOKEN=

# ── Timezone ─────────────────────────────────────────────────
TZ=Europe/Rome
